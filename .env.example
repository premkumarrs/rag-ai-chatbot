# Copy to .env, set the database password in both values, and keep .env out of
# version control. Use a URL-safe password in DATABASE_URL.

DATABASE_URL=
POSTGRES_PASSWORD=
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
LLM_PRESENCE_PENALTY=0
LLM_MAX_OUTPUT_TOKENS=128
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=30m
LLM_STREAMING_ENABLED=true
LLM_REASONING_ENABLED=false
ALLOW_CLOUD_FALLBACK=false
SUPPORT_CONTACT=
LLM_WARMUP=1
